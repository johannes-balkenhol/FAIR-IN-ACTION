# --- data never enters this repository -------------------------------------
# This is a TOOLKIT. If a data file lands here, something has gone wrong.
*.fastq *.fastq.gz *.fq.gz *.bam *.cram *.h5ad *.mtx *.raw *.fcs *.mzML *.tiff
data/ raw/ primary/ processed/

# --- archives: the anti-FAIR format ----------------------------------------
# A zip is opaque, unversioned and undiffable. Unpack it and commit the files.
*.zip *.tar *.tar.gz *.rar "files (*).zip"

# --- filled project metadata belongs to the PROJECT, not the toolkit --------
project.yaml
!project.yaml.template
*_gapsheet.csv
*_metadata.json

# --- notebooks: strip outputs before commit (nbstripout) --------------------
.ipynb_checkpoints/

# --- cruft -----------------------------------------------------------------
__pycache__/ *.pyc .DS_Store .venv/ venv/ .env
